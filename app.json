{
  "expo": {
    "name": "Mi Música",
    "slug": "music-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "mimusica",
    "owner": "jhonas123",

    "icon": "./assets/images/icono.png",

    "android": {
      "package": "com.musicplayer.mimusica",
      "permissions": [
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },

    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ]
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "eas": {
        "projectId": "5a1d1b65-8c33-4f5d-a0be-cbb4fb07fedd"
      }
    }
  }
}