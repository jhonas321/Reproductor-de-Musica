+  private fun emitHmusicNotificationSignal(position: Double) {
+    val event = RemoteSeekEvent(position)
+
+    if (reactContextUsable()) {
+      emitEvent(event)
+    } else {
+      EventBroker.submit(applicationContext, event)
+    }
+  }
